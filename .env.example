# Copy to .env. Nothing in here is a secret on a dev machine; production values
# come from the host's environment, never from a file in the repo.
DEBUG=true
SECRET_KEY=dev-only-change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# The app and the worker connect as portal_app; migrations and tests as portal_owner.
DATABASE_URL=postgresql://portal_app@localhost:5432/sclu_portal
DATABASE_MIGRATE_URL=postgresql://portal_owner@localhost:5432/sclu_portal

# Where raw mail, attachments and produced records are stored in development.
MEDIA_ROOT=./var/media

# Inbound aliases are minted at this domain.
INBOUND_EMAIL_DOMAIN=requests.thesclu.org

# Postmark. Leave empty in development; the webhook refuses without a secret.
POSTMARK_SERVER_TOKEN=
POSTMARK_INBOUND_SECRET=

# Automatic follow-ups create tasks instead of sending until this is true.
FOLLOWUPS_SEND_ENABLED=false

# The site's public address, for the links in the portal's own mail and Keycloak's callbacks.
# PORTAL_PUBLIC_URL=http://localhost:5173

# P25a: sign-in is Keycloak's (notes). On a development machine leave all of these
# unset: they default to the development stack (`just keycloak-up`), and the two secrets are read
# from var/keycloak/dev.env, which keycloak/dev-secrets.sh makes once. In production every one is
# set in the server's environment, never in a file in the repo.
# The realm's public address (the tokens' issuer), Keycloak under /auth on the portal's address:
# KEYCLOAK_ISSUER=https://portal.thesclu.org/auth/realms/sclu
# Keycloak as this server reaches it (back channel: discovery, keys, tokens, the admin API):
# KEYCLOAK_INTERNAL_URL=http://keycloak:8080/auth
# The `portal` client's secret (= the realm file's KEYCLOAK_PORTAL_CLIENT_SECRET):
# KEYCLOAK_CLIENT_SECRET=
# The `portal-admin` service account's secret (= the realm file's KEYCLOAK_ADMIN_CLIENT_SECRET):
# KEYCLOAK_ADMIN_CLIENT_SECRET=
# Where an administrator opens Keycloak's own console (shown in Settings → System; production
# keeps it off the public address, e.g. through an SSH tunnel):
# KEYCLOAK_ADMIN_CONSOLE_URL=http://localhost:8080/auth/admin/sclu/console/
# How long one call to Keycloak may take, in seconds.
# KEYCLOAK_TIMEOUT_SECONDS=10

# P21c: the drafting tool (the SCLU fork of Mike, apps/mike). Whether letters are written there is
# an administrator's switch in Settings → System (off by default), and its two addresses are
# editable there too; these two are only their defaults. The two secrets live here and nowhere
# else (Settings shows only whether each is set). With the switch off, or either secret missing,
# the portal drafts in its own editor. Each secret is at least 32 characters (`openssl rand -hex
# 32`) and is the same value as its counterpart in the fork's root .env, named beside it.
# P25b: the tool signs people in through Keycloak (the realm's `drafting` client, whose secret is
# Keycloak's and the tool's: keycloak/realm/sclu.json, notes), and Keycloak's
# back-channel logout ends its sessions; nothing here is needed for either.
# The fork's API as this server reaches it (laptop: through the fork's gateway).
# DRAFTING_API_URL=http://localhost:3000/api
# The fork's pages as a browser reaches them (the frames' origin and frame-src).
# DRAFTING_WEB_URL=http://localhost:3000
# = the fork's SCLU_PORTAL_SERVICE_SECRET: signs the portal's calls (SCLU.md 14.4).
# DRAFTING_SERVICE_SECRET=
# = the fork's SCLU_WEBHOOK_SECRET: the fork signs its webhooks with it (SCLU.md 9.3). The fork's
# SCLU_WEBHOOK_URL is this portal's /api/drafting/fork/webhook (Settings → System shows it).
# DRAFTING_WEBHOOK_SECRET=
# How long one call to the fork may take, in seconds.
# DRAFTING_TIMEOUT_SECONDS=30
