# P25a: the production Keycloak's settings (notes), checked by `just deploy-check`
# (portal/core/keycloak/checks.py). No secret goes in this file: the database password and the
# bootstrap admin's credentials come from the server's secret store (KC_DB_PASSWORD,
# KC_BOOTSTRAP_ADMIN_USERNAME, KC_BOOTSTRAP_ADMIN_PASSWORD, used only when the master realm is
# first made; replace that temporary admin with a permanent one right after, notes).
#
# One domain: Keycloak serves under /auth on the portal's own address, behind the same nginx that
# terminates TLS for the portal; nginx forwards only /auth/realms/ and /auth/resources/ (never
# /auth/admin/), so the admin console is not on the public address at all. Administrators reach
# it through an SSH tunnel to the management host (KC_HOSTNAME_ADMIN below).
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://127.0.0.1:5432/keycloak
KC_DB_USERNAME=keycloak
KC_HOSTNAME=https://portal.thesclu.org/auth
KC_HOSTNAME_STRICT=true
KC_HOSTNAME_BACKCHANNEL_DYNAMIC=true
KC_HOSTNAME_ADMIN=http://localhost:8080/auth
KC_HTTP_ENABLED=true
KC_HTTP_PORT=8080
KC_HTTP_HOST=127.0.0.1
KC_HTTP_RELATIVE_PATH=/auth
KC_PROXY_HEADERS=xforwarded
KC_PROXY_TRUSTED_ADDRESSES=127.0.0.1/32
KC_HEALTH_ENABLED=true
KC_METRICS_ENABLED=false
# Keycloak's own login and admin events go to its log as well as its database.
KC_LOG=console
KC_LOG_LEVEL=info
