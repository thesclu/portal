{
  "name": "sclu-keycloak-theme",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/portal-assets.mjs",
    "dev": "vite",
    "typecheck": "node scripts/portal-assets.mjs && tsc --noEmit",
    "prebuild": "node scripts/portal-assets.mjs",
    "build": "tsc --noEmit && vite build",
    "build-keycloak-theme": "npm run build && keycloakify build"
  },
  "dependencies": {
    "keycloakify": "11.16.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.2"
  }
}
